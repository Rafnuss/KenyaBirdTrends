{
  "title": "Kenya Bird Trends",
  "name": "kenyabirdtrends",
  "description": "Visualisation of the distribution changes of birds in Kenya between 1970s and 2010s",
  "version": "0.4.1",
  "homepage": "https://kenyabirdtrends.co.ke/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rafnuss/KenyaBirdTrends.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write src index.html vite.config.js",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo_crane.svg",
    "build:county": "node scripts/build-county-geojson.mjs",
    "sync:data": "node scripts/sync-species-data.mjs"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "chroma-js": "~3.2.0",
    "leaflet": "~1.9.4",
    "leaflet-geosearch": "~5.2.0",
    "leaflet.locatecontrol": "~0.90.1",
    "vue": "^3.5.44",
    "vue-multiselect": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@vite-pwa/assets-generator": "~2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "~10.2.0",
    "eslint": "~10.14.0",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-vue": "~10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "~3.9.10",
    "sass": "~1.107.1",
    "vite": "~8.3.5",
    "vite-plugin-pwa": "~2.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "workbox-build": {
      "glob": "^14.0.3"
    }
  }
}
