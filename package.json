{
  "title": "Kenya Bird Trends",
  "name": "kenyabirdtrends",
  "description": "Visualisation of the distribution changes of birds in Kenya between 1970s and 2010s",
  "version": "0.3.8",
  "homepage": "https://kenyabirdtrends.co.ke/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rafnuss/KenyaBirdTrends.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write src index.html vite.config.js",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo_crane.svg",
    "build:county": "node scripts/build-county-geojson.mjs"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "chroma-js": "~3.2.0",
    "leaflet": "~1.9.4",
    "leaflet-geosearch": "~4.4.0",
    "leaflet.locatecontrol": "~0.90.1",
    "vue": "^3.5.42",
    "vue-multiselect": "^3.5.0"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "~1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "~10.2.0",
    "eslint": "~9.39.0",
    "eslint-plugin-prettier": "~5.5.6",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "prettier": "~3.9.6",
    "sass": "~1.104.0",
    "vite": "~7.3.6",
    "vite-plugin-pwa": "~1.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "~10.4.1"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
